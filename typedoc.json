  "navigation": { "includeCategories": true, "includeGroups": false },
  "navigationLinks": {
    "Guide": "https://memoriainfinita.github.io/UMT/api-docs/documents/GUIDE.html",
    "Demo": "https://memoriainfinita.github.io/UMT",
    "GitHub": "https://github.com/memoriainfinita/UMT"
  }
}
