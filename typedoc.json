{
  "entryPoints": ["lib/music-theory/index.ts"],
  "out": "api-docs",
  "name": "Universal Music Theory Library",
  "readme": "README.md",
  "excludeInternal": true,
  "excludePrivate": true,
  "includeVersion": true,
  "tsconfig": "./tsconfig.typedoc.json",
  "customCss": "./docs-theme/custom.css",
  "customJs": "./docs-theme/custom.js",
  "lightHighlightTheme": "rose-pine-dawn",
  "darkHighlightTheme": "vitesse-dark",
